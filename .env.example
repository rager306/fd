# Local fd Docker Compose environment template.
# Copy to .env for local development overrides.
# Never commit real secrets. The real .env file is gitignored.

# Protected endpoints fail closed when unset. Set a local random value to test
# /v1/embeddings, /v1/cache/*, /metrics, and other protected routes.
FD_API_KEY=

# Current production/default runtime is TEI with deepvk/USER-bge-m3.
MODEL_ID=deepvk/USER-bge-m3
TEI_URL=http://tei:80

# Redis inside Docker Compose.
REDIS_HOST=redis:6379
REDIS_QUEUE=embed:queue
CACHE_PREFIX=embed:cache:
REDIS_POOL_SIZE=50
REDIS_CACHE_TTL=
REDIS_CACHE_NO_EXPIRE=
# L2 key fast path: string literals for dims 1024/512 instead of
# strconv.Itoa (one less heap allocation per key). Key format is unchanged.
# Default true; set false to force the generic branch.
REDIS_CACHE_KEY_FASTPATH=true

# fd in-memory L1 cache tuning (Issue #480). Entries are evicted in
# least-recently-used order when either budget overflows. 200000 entries and
# 512 MiB of payload (len(key)+len(value) per entry) bound the footprint;
# set either to 0 to disable that limit. The payload byte count is not Go
# heap usage.
FD_CACHE_MAX_SIZE=200000
FD_CACHE_MAX_BYTES=536870912
FD_CACHE_LOCAL_TTL=30s

# Async bulk-ingestion queue (Phase 2, Issue #9). Enable to accept POSTs to
# /v1/queue for non-blocking bulk embedding submissions. Off by default.
FD_QUEUE_ENABLED=false
FD_QUEUE_MAX_SIZE=1024
FD_QUEUE_BATCH_MAX_SIZE=32
FD_QUEUE_BATCH_WINDOW_MS=10ms

# Correctness-affecting cache namespace knobs. Change these when comparing
# different backends/models/tokenizers/chunking, or deliberately flush Redis.
EMBEDDING_CACHE_VERSION=
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_REVISION=
EMBEDDING_TOKENIZER_VERSION=
EMBEDDING_CHUNKING_VERSION=

# Runtime controls.
# HTTP server deadlines (Go duration). Write covers the read deadline (headers +
# body), the 30s handler budget, and the response; zero, negative, or
# unparseable values use the defaults.
FD_HTTP_READ_TIMEOUT=35s
FD_HTTP_WRITE_TIMEOUT=75s
FD_HTTP_IDLE_TIMEOUT=75s
FD_MAX_IN_FLIGHT=0
FD_CORS_ORIGINS=
FD_RATE_LIMIT_ENABLED=
FD_TRACES_ENABLED=
LOG_LEVEL=info
GIN_MODE=release
